# Copy this file to .env and fill in whatever you want to use.
# Everything here is optional — you can also enter all of it in the app's
# Settings dialog, which writes to settings.json instead. Both files are
# gitignored, so your keys never end up in a commit.

# ─── AI engines ───────────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey (free tier available)
#   Required for "Read screen" (Gemini watches the video and transcribes
#   slides / whiteboards / on-screen code).
#   Multiple keys are supported: one per line, or comma-separated. They run in
#   parallel and their quotas add up.
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenCode Zen — https://opencode.ai/zen (optional)
#   The free models (ids ending in -free) work without any key at all, which is
#   why the app is usable with this whole file left empty.
OPENCODE_API_KEY=

# ─── Output ───────────────────────────────────────────────────────────────
# Language the AI writes cards and answers in.
# One of: zh-Hant | zh-Hans | en | ja | ko | es
OUTPUT_LANGUAGE=en

# ─── Obsidian (optional) ──────────────────────────────────────────────────
# Absolute path to your Obsidian vault. Leave empty to disable note saving.
#   macOS / Linux: /Users/you/Documents/ObsidianVault
#   Windows:       C:\Users\you\Documents\ObsidianVault
OBSIDIAN_VAULT_PATH=

# Folder inside the vault where notes are written.
OBSIDIAN_NOTES_FOLDER=Youtube Card Reader
